# Application
NODE_ENV=development
PORT=3000

# MongoDB (the database name must remain exactly comp3123_assignment1)
MONGODB_URI=mongodb://127.0.0.1:27017/comp3123_assignment1
MONGODB_DB_NAME=comp3123_assignment1

# Authentication
# Replace this example value with a random secret of at least 32 UTF-8 bytes. Never commit .env.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1h

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=100

# Automated tests only. Keep false in development and production.
DISABLE_RATE_LIMIT=false
